<UserControl x:Class="ArticleReviewApp.Views.UserControls.ArticleEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ArticleReviewApp.Views.UserControls"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="500">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Title" FontWeight="Bold" />
            <TextBox x:Name="TitleTextBox" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Description" FontWeight="Bold" />
            <TextBox x:Name="DescriptionTextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="60" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Content" FontWeight="Bold" Margin="0,0,0,4" />

        <TextBox x:Name="ContentTextBox"
                 Grid.Row="3"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,8" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ApproveButton" Content="Approve" Width="80" IsEnabled="False"
                    ToolTip="Not available yet: articles have no approval status" />
            <Button x:Name="DenyButton" Content="Deny" Width="80" Margin="8,0,0,0" IsEnabled="False"
                    ToolTip="Not available yet: articles have no approval status" />
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Margin="24,0,0,0" />
            <Button x:Name="SaveButton" Content="Save" Width="80" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
